#!/usr/bin/env python3
"""Convert fluidized-bed LIGGGHTS dumps to ParaView CSV frames.

Reads DEM dumps written by CFDEM / LIGGGHTS:
  post/dump*.liggghts_run   (coupled run — one file per dump interval)
  post/dump.liggghts_init   (optional packing dumps; multi-timestep OK)

Usage (from fluidized-bed/DEM):
  ./dumpsToParaView
  ./dumpsToParaView --init

Output columns:
  id,type,x,y,z,vx,vy,vz,vmag,radius[,fdx,fdy,fdz,fdmag]

ParaView:
  File -> Open frame_*.csv series -> Table To Points (x,y,z)
  Color by vmag or fdmag; Glyph -> Sphere by radius
"""

import argparse
import re
import sys
from math import sqrt
from pathlib import Path


def parse_atoms_header(line):
    """'ITEM: ATOMS id type x y z ...' -> column name list."""
    if "ITEM: ATOMS" not in line:
        raise ValueError("Not an ATOMS header: %s" % line)
    cols = line.split("ITEM: ATOMS", 1)[1].split()
    out = []
    for c in cols:
        if c.startswith("f_dragforce["):
            idx = c[c.find("[") + 1 : c.find("]")]
            out.append({"1": "fdx", "2": "fdy", "3": "fdz"}.get(idx, c))
        else:
            out.append(c)
    return out


def format_row(cols, parts):
    """Build one CSV row from named columns. Returns None if incomplete."""
    if len(parts) < len(cols):
        return None
    try:
        data = dict((name, parts[i]) for i, name in enumerate(cols))
        int(data["id"])
    except (KeyError, ValueError, IndexError):
        return None

    needed = ("id", "type", "x", "y", "z", "vx", "vy", "vz", "radius")
    for k in needed:
        if k not in data:
            return None

    vx = float(data["vx"])
    vy = float(data["vy"])
    vz = float(data["vz"])
    vmag = sqrt(vx * vx + vy * vy + vz * vz)

    row = [
        data["id"],
        data["type"],
        data["x"],
        data["y"],
        data["z"],
        data["vx"],
        data["vy"],
        data["vz"],
        "%.8g" % vmag,
        data["radius"],
    ]

    if all(k in data for k in ("fdx", "fdy", "fdz")):
        fdx = float(data["fdx"])
        fdy = float(data["fdy"])
        fdz = float(data["fdz"])
        fdmag = sqrt(fdx * fdx + fdy * fdy + fdz * fdz)
        row.extend([data["fdx"], data["fdy"], data["fdz"], "%.8g" % fdmag])

    return ",".join(row) + "\n"


def csv_header(cols):
    base = "id,type,x,y,z,vx,vy,vz,vmag,radius"
    if all(k in cols for k in ("fdx", "fdy", "fdz")):
        return base + ",fdx,fdy,fdz,fdmag\n"
    return base + "\n"


def convert_dump_text(text, out_dir, prefix="frame"):
    """Parse dump text (may contain multiple timesteps). Return frame count."""
    lines = text.splitlines()
    n_frames = 0
    current_time = 0
    frame_data = []
    cols = None
    header = "id,type,x,y,z,vx,vy,vz,vmag,radius\n"

    def flush():
        nonlocal n_frames, frame_data
        if not frame_data:
            return
        path = out_dir / ("%s_%d.csv" % (prefix, current_time))
        path.write_text(header + "".join(frame_data))
        n_frames += 1
        frame_data = []

    # Python 3.5 may not support nonlocal the same in all cases - use list trick if needed
    # Actually nonlocal exists since 3.0. Keep it.

    i = 0
    while i < len(lines):
        line = lines[i].strip()
        if "ITEM: TIMESTEP" in line:
            flush()
            current_time = int(lines[i + 1].strip())
            i += 2
            continue

        if "ITEM: ATOMS" in line:
            cols = parse_atoms_header(line)
            header = csv_header(cols)
            i += 1
            continue

        if line.startswith("ITEM:"):
            i += 1
            continue

        if cols is not None:
            parts = line.split()
            row = format_row(cols, parts)
            if row is not None:
                frame_data.append(row)
        i += 1

    flush()
    return n_frames


def timestep_from_name(path):
    """dump150000.liggghts_run -> 150000"""
    m = re.search(r"dump(\d+)\.liggghts_run$", path.name)
    return int(m.group(1)) if m else None


def main():
    ap = argparse.ArgumentParser(description="Convert LIGGGHTS dumps to ParaView CSV")
    ap.add_argument(
        "--dir",
        type=Path,
        default=None,
        help="Directory with dump files (default: <script>/post)",
    )
    ap.add_argument(
        "--init",
        action="store_true",
        help="Also convert post/dump.liggghts_init",
    )
    args = ap.parse_args()

    script_dir = Path(__file__).resolve().parent
    out_dir = args.dir or (script_dir / "post")
    if not out_dir.is_dir():
        sys.exit("ERROR: dump directory not found: %s" % out_dir)

    run_dumps = sorted(
        out_dir.glob("dump*.liggghts_run"),
        key=lambda p: timestep_from_name(p) or 0,
    )

    total = 0

    for dump in run_dumps:
        # Path.read_text exists in 3.5+
        text = dump.read_text()
        n = convert_dump_text(text, out_dir, prefix="frame")
        total += n
        print("  %s -> %d frame(s)" % (dump.name, n))

    if args.init:
        init_dump = out_dir / "dump.liggghts_init"
        if init_dump.is_file():
            n = convert_dump_text(init_dump.read_text(), out_dir, prefix="init_frame")
            total += n
            print("  %s -> %d frame(s) (prefix init_frame_)" % (init_dump.name, n))
        else:
            print("  (no %s)" % init_dump.name)

    if total == 0 and not run_dumps:
        sys.exit(
            "ERROR: no dump*.liggghts_run files in %s\n"
            "Run the CFDEM case first, then: ./dumpsToParaView" % out_dir
        )

    print("Success! Wrote %d CSV frame(s) to %s/" % (total, out_dir))
    print("Columns: id,type,x,y,z,vx,vy,vz,vmag,radius[,fdx,fdy,fdz,fdmag]")
    print("ParaView: open frame_*.csv -> Table To Points (x,y,z) -> color by vmag")


if __name__ == "__main__":
    main()
