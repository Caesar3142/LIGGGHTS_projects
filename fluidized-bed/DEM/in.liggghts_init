# DEM init: pack particles in the lower part of the fluidized bed, then settle
echo            both
log             ../DEM/log.liggghts

atom_style      granular
atom_modify     map array
communicate     single vel yes

boundary        m m m
newton          off

units           si

# Domain: D ≈ 27.6 mm cylinder, H = 150 mm (matches CFD blockMeshDict)
region          reg block -0.015 0.015 -0.015 0.015 -0.001 0.151 units box
create_box      1 reg

neighbor        0.001 bin
neigh_modify    delay 0

# Soft spheres (demo Young's modulus; raise for steel if needed)
fix         m1 all property/global youngsModulus peratomtype 5.e6
fix         m2 all property/global poissonsRatio peratomtype 0.45
fix         m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix         m4 all property/global coefficientFriction peratomtypepair 1 0.5

pair_style  gran model hertz tangential history
pair_coeff  * *

timestep    0.00001
fix         gravi all gravity 9.81 vector 0.0 0.0 -1.0

# Walls: bottom, top, cylindrical side wall
fix     zwalls1  all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix     zwalls2  all wall/gran model hertz tangential history primitive type 1 zplane 0.15
fix     cylwalls all wall/gran model hertz tangential history primitive type 1 zcylinder 0.01385 0. 0.

# Insert ~4000 spheres (d = 1 mm) into lower packing region
# NOTE: keep insert/pack on ONE line — LIGGGHTS does not accept \ continuations here
region  bc cylinder z 0.0 0.0 0.012 0.0 0.045 units box
fix     pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2000 radius constant 0.0005
fix     pdd1 all particledistribution/discrete 15485867 1 pts1 1.0
fix     ins all insert/pack seed 32452843 distributiontemplate pdd1 vel constant 0. 0. -0.5 insert_every once overlapcheck yes all_in yes particles_in_region 4000 region bc

fix     integr all nve/sphere

compute         rke all erotate/sphere
thermo_style    custom step atoms ke c_rke vol
thermo          1000
thermo_modify   lost ignore norm no

run         1
dump        dmp all custom 10000 post/dump.liggghts_init id type x y z ix iy iz vx vy vz fx fy fz omegax omegay omegaz radius

# Settle packing under gravity
run         50000 upto
write_restart   post/restart/liggghts.restart
