FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Inlet ramps to a superficial velocity above Umf (demo fluid props).

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    wall
    {
        type            slip;
    }

    inlet
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0.0   (0 0 0.02))
            (0.2   (0 0 0.15))
            (2.0   (0 0 0.15))
        );
    }

    outlet
    {
        type            zeroGradient;
    }
}

