# ===================================================
# Rubber-like long fibers (multisphere) drop onto tilted 1x1 m ground
# Each fiber ≈ 152 mm long × 10 mm diameter (20 overlapping spheres)
# Soft contacts + fine dt/dumps so bounce is resolved smoothly
# ===================================================

# 1. Variable Definitions - rubber-like
#    E ~ few MPa, near-incompressible Poisson, high restitution & friction
variable        youngs       equal 5.e6
variable        poisson      equal 0.49
variable        restitution  equal 0.80
variable        friction     equal 0.70
variable        density_val  equal 1100

# 2. Initialization (sphere + map array required for multisphere)
units           si
atom_style      sphere
atom_modify     map array sort 0 0.0
boundary        f f f
newton          off
communicate     single vel yes
processors      1 1 1

# 3. Domain - 1x1 m ground tilted 12 deg (high at x=0, low at x=1)
#    Extra headroom in z for ~15 cm fibers inserted with random orientation
region          reg block -0.05 1.05 -0.05 1.05 -0.25 1.4 units box
create_box      1 reg

# 4. Material Properties & Contact Model Setup
fix             m1 all property/global youngsModulus peratomtype ${youngs}
fix             m2 all property/global poissonsRatio peratomtype ${poisson}
fix             m3 all property/global coefficientRestitution peratomtypepair 1 ${restitution}
fix             m4 all property/global coefficientFriction peratomtypepair 1 ${friction}
fix             m5 all property/global density peratomtype ${density_val}

pair_style      gran model hertz tangential history
pair_coeff      * *

# 5. Neighbor List settings (skin ~ diameter of constituent spheres)
neighbor        0.002 bin
neigh_modify    delay 0 every 1 check yes

# 6. Gravity straight down & refined timestep
#    Soft rubber Hertz contacts: dt = 1e-6 resolves bounce compression
fix             grav all gravity 9.81 vector 0.0 0.0 -1.0
timestep        0.000001

# 7. STL ground mesh wall (1x1 m, tilted ~12 deg)
fix             ground all mesh/surface file 1x1m-ground.stl type 1
fix             walls all wall/gran model hertz tangential history mesh n_meshes 1 meshes ground

# Soft ceiling / floor so lost fibers are rare during settle
fix             z_wall_hi all wall/gran model hertz tangential history primitive type 1 zplane 1.35
fix             z_wall_lo all wall/gran model hertz tangential history primitive type 1 zplane -0.20

# 8. Long-fiber template: rigid chain of 20 spheres (see data/fiber.multisphere)
fix             pts1 all particletemplate/multisphere 15485863 atom_type 1 &
                density constant ${density_val} &
                nspheres 20 ntry 1000000 &
                spheres file data/fiber.multisphere scale 1.0 type 1
fix             pdd1 all particledistribution/discrete 15485867 1 pts1 1.0

# Spawn above high end of ramp; region sized for ~15 cm fibers
region          spawner block 0.05 0.55 0.15 0.85 0.55 1.10 units box
fix             ins all insert/pack seed 32452843 distributiontemplate pdd1 &
                insert_every once overlapcheck yes all_in yes &
                vel constant 0. 0. 0. &
                region spawner ntry_mc 100000 particles_in_region 40

# 9. Integration Style - rigid multisphere bodies (not nve/sphere)
fix             integr all multisphere

# 10. Thermo Output Diagnostics
compute         1 all erotate/sphere
thermo_style    custom step atoms ke c_1 cpu
thermo          10000
thermo_modify   lost ignore

# 11. Data dumps — cyclone-style dump*.liggghts_run
#     Every 1000 steps = 0.001 s → smooth bounce playback in ParaView
# Create post/ on the host before running if it does not exist:
#   mkdir -p post
dump            dmp all custom 1000 post/dump*.liggghts_run id type mol x y z vx vy vz radius

# Optional: export mesh for ParaView overlay (* required by LIGGGHTS mesh/stl)
dump            mesh1 all mesh/stl 100000000 post/ground_mesh_*.stl ground

# 12. Run until bounce/settle (~3 s physical time at dt = 1e-6)
# Watch KE in thermo: when it stays near zero, fibers have settled.
run             3000000
