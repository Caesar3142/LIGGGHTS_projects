# ===================================================
# Steel balls (20 mm) drop 0.5 m onto tilted 1x1 m ground
# ===================================================

# 1. Variable Definitions - steel
variable        youngs       equal 2.1e11
variable        poisson      equal 0.30
variable        restitution  equal 0.7
variable        friction     equal 0.15
variable        density_val  equal 7850
variable        p_diameter   equal 0.02

# 2. Initialization
units           si
atom_style      granular
atom_modify     sort 0 0.0
boundary        f f f
newton          off
communicate     single vel yes
hard_particles  yes

# 3. Domain - 1x1 m ground tilted 12 deg (high at x=0, low at x=1)
region          reg block -0.05 1.05 -0.05 1.05 -0.25 1.2 units box
create_box      1 reg

# 4. Material Properties & Contact Model Setup
fix             m1 all property/global youngsModulus peratomtype ${youngs}
fix             m2 all property/global poissonsRatio peratomtype ${poisson}
fix             m3 all property/global coefficientRestitution atomtypepair 1 ${restitution}
fix             m4 all property/global coefficientFriction atomtypepair 1 ${friction}

pair_style      gran model hertz tangential history
pair_coeff      * *

# 5. Neighbor List settings (skin ~10% of diameter)
neighbor        0.002 bin
neigh_modify    delay 0 every 1 check yes

# 6. Gravity straight down & timestep
# Steel + Hertz is stiff: dt ~ 1e-6 s (~10% Rayleigh for 20 mm steel)
fix             grav all gravity 9.81 vector 0.0 0.0 -1.0
timestep        0.000001

# 7. STL ground mesh wall (1x1 m, tilted ~12 deg)
fix             ground all mesh/surface file 1x1m-ground.stl type 1
fix             walls all wall/gran model hertz tangential history mesh n_meshes 1 meshes ground

# Soft ceiling
fix             z_wall_hi all wall/gran model hertz tangential history primitive type 1 zplane 1.15

# 8. Particle generation - drop ~0.5 m above the HIGH end of the ramp (small x)
#     ground z at x~0.2 is ~+0.064; centers near z ~= 0.58
#     spawn slab must be thick enough to contain a lattice plane (sc 0.025)
fix             m5 all property/global density peratomtype ${density_val}

region          spawner block 0.15 0.40 0.25 0.75 0.56 0.59 units box
lattice         sc 0.025
create_atoms    1 region spawner

set             region spawner density ${density_val} diameter ${p_diameter}

# 9. Integration Style
fix             integrate_flow all nve/sphere

# 10. Thermo Output Diagnostics
thermo_style    custom step atoms ke cpu
thermo          10000
thermo_modify   lost ignore

# 11. Data dumps (relative to this case folder)
# Create post/ on the host before running if it does not exist:
#   mkdir -p post
dump            dmp all custom 10000 post/trajectory.dump id type x y z vx vy vz radius

# Optional: export mesh for ParaView overlay (* required by LIGGGHTS mesh/stl)
dump            mesh1 all mesh/stl 100000000 post/ground_mesh_*.stl ground

# 12. Run until they slide/settle (~3 s physical time at dt = 1e-6)
# Watch KE in thermo: when it stays near zero, particles have settled.
run             3000000
