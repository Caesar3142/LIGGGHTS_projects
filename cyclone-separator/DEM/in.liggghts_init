# Optional DEM-only geometry check for the empty cyclone.
echo            both
log             ../DEM/log.liggghts

atom_style      granular
atom_modify     map array
atom_modify     sort 0 0.0
communicate     single vel yes

boundary        f f f
newton          off

units           si

# Domain encloses body.stl (x/y +/-0.161, z -0.308 to 0.172 m).
region          reg block -0.18 0.18 -0.18 0.18 -0.32 0.18 units box
create_box      1 reg

neighbor        0.0003 bin
neigh_modify    delay 0

# Effective quartz/sand contact properties. Young's modulus is softened from
# real quartz to keep the demonstration time step practical.
fix         m1 all property/global youngsModulus peratomtype 1.e7
fix         m2 all property/global poissonsRatio peratomtype 0.25
fix         m3 all property/global coefficientRestitution peratomtypepair 1 0.45
fix         m4 all property/global coefficientFriction peratomtypepair 1 0.40

pair_style  gran model hertz tangential history
pair_coeff  * *

timestep    0.000002
fix         gravi all gravity 9.81 vector 0.0 0.0 -1.0

# body.stl includes the cyclone shell, inlet duct and collection bin walls.
fix         bodyMesh all mesh/surface file body.stl type 1 element_exclusion_list read body.exclude curvature_tolerant yes
fix         walls all wall/gran model hertz tangential history mesh n_meshes 1 meshes bodyMesh

thermo_style    custom step atoms ke vol
thermo          1
thermo_modify   lost ignore norm no

run             0
write_restart   post/restart/liggghts.restart
