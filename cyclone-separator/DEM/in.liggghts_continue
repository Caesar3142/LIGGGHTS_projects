# DEM continue: resume from a binary restart written during a prior coupled run.
# Generated/selected by ../parCFDDEMcontinue.sh - do not start from this file alone.
echo            both
log             ../DEM/log.liggghts

atom_style      granular
atom_modify     map array
atom_modify     sort 0 0.0
communicate     single vel yes

boundary        f f f
newton          off

units           si
processors      2 2 2

# Binary restart written by LIGGGHTS `restart` / CFDEM writeLiggghts.
read_restart    ../DEM/post/restart/liggghts.continue

neighbor        0.0003 bin
neigh_modify    delay 0

fix         m1 all property/global youngsModulus peratomtype 1.e7
fix         m2 all property/global poissonsRatio peratomtype 0.25
fix         m3 all property/global coefficientRestitution peratomtypepair 1 0.45
fix         m4 all property/global coefficientFriction peratomtypepair 1 0.40

pair_style  gran model hertz tangential history
pair_coeff  * *

timestep    0.000002
fix         gravi all gravity 9.81 vector 0.0 0.0 -1.0

fix         bodyMesh all mesh/surface file ../DEM/body.stl type 1 element_exclusion_list read ../DEM/body.exclude curvature_tolerant yes
fix         walls all wall/gran model hertz tangential history mesh n_meshes 1 meshes bodyMesh

# Keep injecting at the same rate. parCFDDEMcontinue.sh rewrites nparticles
# (remaining budget) and adds start <resumeStep> - required after read_restart
# because default start=0 is before the current DEM step.
fix         dust all particletemplate/sphere 15485863 atom_type 1 density constant 2650 radius constant 0.000075
fix         fine all particletemplate/sphere 15485867 atom_type 1 density constant 2650 radius constant 0.000150
fix         sand all particletemplate/sphere 32452843 atom_type 1 density constant 2650 radius constant 0.000300
fix         feedDist all particledistribution/discrete 32452867 3 dust 0.10 fine 0.35 sand 0.55

region      feed block 0.138 0.145 -0.090 -0.050 -0.020 0.020 units box
fix         inject all insert/rate/region seed 49979687 distributiontemplate feedDist nparticles 125 particlerate 250 insert_every 25000 overlapcheck yes all_in yes vel constant -15.0 0.0 0.0 region feed

fix         cfd all couple/cfd couple_every 5000 mpi
fix         cfd2 all couple/cfd/force/implicit

fix         integr all nve/sphere

compute     explDrag all reduce update_on_run_end yes sum f_dragforce[1] f_dragforce[2] f_dragforce[3]

variable    totalDragX equal f_cfd2[1]
variable    totalDragY equal f_cfd2[2]
variable    totalDragZ equal f_cfd2[3]
variable    explicitDragX equal c_explDrag[1]
variable    explicitDragY equal c_explDrag[2]
variable    explicitDragZ equal c_explDrag[3]
variable    time equal step*dt

fix         extra all print 500 "${time} ${explicitDragX} ${explicitDragY} ${explicitDragZ} ${totalDragX} ${totalDragY} ${totalDragZ}" file ../DEM/post/forces_continue.txt title "# time expDrag(X Y Z) totDrag(X Y Z)"

compute         rke all erotate/sphere
thermo_style    custom step atoms ke c_rke vol
thermo          5000
thermo_modify   lost ignore norm no

dump            dmp all custom 2500 ../DEM/post/dump*.liggghts_run id type x y z vx vy vz fx fy fz f_dragforce[1] f_dragforce[2] f_dragforce[3] radius
restart         2500 ../DEM/post/restart/liggghts.restart.*

run             0
