#!/usr/bin/env python3
"""Convert LIGGGHTS trajectory.dump to ParaView CSV frames.

Usage (from the case folder):
  ./dumpsToParaView

Looks for post/trajectory.dump next to this script (or under ./post
if you run it from elsewhere with cwd = case folder).
"""

from pathlib import Path

script_dir = Path(__file__).resolve().parent
candidates = [
    script_dir / "post" / "trajectory.dump",
    Path.cwd() / "post" / "trajectory.dump",
    Path.cwd() / "trajectory.dump",  # also allow running inside post/
]

dump = next((p for p in candidates if p.is_file()), None)
if dump is None:
    raise SystemExit(
        "ERROR: could not find trajectory.dump.\n"
        "Expected: <case>/post/trajectory.dump\n"
        "Run from the case folder: ./dumpsToParaView"
    )

out_dir = dump.parent
lines = dump.read_text().splitlines()

current_time = 0
frame_data = []
columns_header = "id,type,x,y,z,vx,vy,vz,radius\n"
n_frames = 0

i = 0
while i < len(lines):
    line = lines[i].strip()
    if "ITEM: TIMESTEP" in line:
        if frame_data:
            (out_dir / f"frame_{current_time}.csv").write_text(
                columns_header + "".join(frame_data)
            )
            n_frames += 1
            frame_data = []
        current_time = int(lines[i + 1].strip())
        i += 2
        continue

    if "ITEM:" in line:
        i += 1
        continue

    parts = line.split()
    if len(parts) == 9:
        try:
            int(parts[0])
            frame_data.append(",".join(parts) + "\n")
        except ValueError:
            pass
    i += 1

if frame_data:
    (out_dir / f"frame_{current_time}.csv").write_text(
        columns_header + "".join(frame_data)
    )
    n_frames += 1

print(f"Success! Wrote {n_frames} frames to {out_dir}/ (last timestep {current_time}).")
