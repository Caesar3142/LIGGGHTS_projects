#!/usr/bin/env python3
"""Convert LIGGGHTS trajectory.dump to ParaView CSV frames.

Usage (from the case folder):
  ./dumpsToParaView

Output columns (for ParaView):
  id, type, x, y, z, vx, vy, vz, vmag, radius
  - x,y,z  : position (use Table To Points)
  - vmag   : velocity magnitude = sqrt(vx^2+vy^2+vz^2) for coloring
"""

from math import sqrt
from pathlib import Path

script_dir = Path(__file__).resolve().parent
candidates = [
    script_dir / "post" / "trajectory.dump",
    Path.cwd() / "post" / "trajectory.dump",
    Path.cwd() / "trajectory.dump",
]

dump = next((p for p in candidates if p.is_file()), None)
if dump is None:
    raise SystemExit(
        "ERROR: could not find trajectory.dump.\n"
        "Expected: <case>/post/trajectory.dump\n"
        "Run from the case folder: ./dumpsToParaView"
    )

out_dir = dump.parent
lines = dump.read_text().splitlines()

current_time = 0
frame_data = []
columns_header = "id,type,x,y,z,vx,vy,vz,vmag,radius\n"
n_frames = 0


def format_atom_row(parts):
    """parts: id type x y z vx vy vz radius  -> CSV with vmag."""
    pid, ptype = parts[0], parts[1]
    x, y, z = parts[2], parts[3], parts[4]
    vx, vy, vz = float(parts[5]), float(parts[6]), float(parts[7])
    radius = parts[8]
    vmag = sqrt(vx * vx + vy * vy + vz * vz)
    return f"{pid},{ptype},{x},{y},{z},{vx},{vy},{vz},{vmag:.8g},{radius}\n"


i = 0
while i < len(lines):
    line = lines[i].strip()
    if "ITEM: TIMESTEP" in line:
        if frame_data:
            (out_dir / f"frame_{current_time}.csv").write_text(
                columns_header + "".join(frame_data)
            )
            n_frames += 1
            frame_data = []
        current_time = int(lines[i + 1].strip())
        i += 2
        continue

    if "ITEM:" in line:
        i += 1
        continue

    parts = line.split()
    if len(parts) == 9:
        try:
            int(parts[0])
            frame_data.append(format_atom_row(parts))
        except ValueError:
            pass
    i += 1

if frame_data:
    (out_dir / f"frame_{current_time}.csv").write_text(
        columns_header + "".join(frame_data)
    )
    n_frames += 1

print(f"Success! Wrote {n_frames} frames to {out_dir}/ (last timestep {current_time}).")
print("Columns: id,type,x,y,z,vx,vy,vz,vmag,radius")
print("ParaView: Table To Points (x,y,z) then color by vmag.")
